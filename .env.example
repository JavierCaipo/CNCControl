# ==============================================================================
# CNC-Control: Variables de Entorno (Vercel & Supabase)
# ==============================================================================

# 1. Base de Datos Supabase (PostgreSQL)
# IMPORTANTE: Para Vercel y entornos Serverless, utiliza la URL del Transaction Pooler
# (PgBouncer en el puerto 6543) que puedes obtener en:
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Transaction)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# 2. Secreto de Autenticación JWT (jose / Cookies HTTP-only)
# Clave criptográfica para firmar los tokens de sesión de operarios y gerentes.
# Puedes generar una clave aleatoria segura ejecutando en tu terminal: openssl rand -base64 32
AUTH_SECRET="your-32-character-or-longer-secret-key-here"


# ==============================================================================
# CNC-Control (SaaS Multi-Tenant): Variables de Entorno
# ==============================================================================

# 1. Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
# Opción A (Desarrollo Local con Docker Compose - Fase 2):
# Ejecuta `npm run db:up` y usa el puerto 5433:
DATABASE_URL="postgresql://cnc_dev:cnc_dev_pass@localhost:5433/cnc_control_dev"

# Opción B (Producción / Supabase Transaction Pooler - PgBouncer puerto 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# 2. Secreto de Autenticación JWT (jose / Cookies HTTP-only)
# ------------------------------------------------------------------------------
# Clave criptográfica para firmar los tokens de sesión de operarios, supervisores, gerentes y superadmins.
# Generar clave segura: openssl rand -base64 32
AUTH_SECRET="your-32-character-or-longer-secret-key-here"
